# pnpm configuration.
#
# The strict peer-dependency setting keeps installs reproducible: a dependency
# whose peer requirements are unmet fails loudly rather than silently resolving
# to something unexpected.
strict-peer-dependencies=false

# Keep the lockfile authoritative so CI and Vercel install exactly what was
# tested locally.
prefer-frozen-lockfile=true

# Hoist nothing implicitly; the project needs only its two direct dependencies.
public-hoist-pattern[]=
