{
  "name": "sd-cs-notes",
  "version": "2.0.0",
  "description": "Static site generator that turns Markdown study notes into a searchable, printable HTML site.",
  "private": true,
  "main": "src/build.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node src/cli.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "preview": "npm run build && npx --yes serve dist",
    "test": "node --test tests/"
  },
  "keywords": [
    "static-site-generator",
    "markdown",
    "notes",
    "handlebars",
    "marked"
  ],
  "license": "ISC",
  "dependencies": {
    "handlebars": "^4.7.9",
    "marked": "^18.0.10"
  }
}
